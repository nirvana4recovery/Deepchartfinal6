{
  "name": "@workspace/trading-journal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bash ../../scripts/ensure-install.sh",
    "dev": "pnpm exec vite --config vite.config.ts --host 0.0.0.0",
