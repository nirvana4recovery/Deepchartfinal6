# Telegram bot — create with BotFather, then allowlist your numeric Telegram user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TRENDLINE_STATE_FILE=trendline_alerts.json
LOG_LEVEL=INFO

# Bybit public market data. Category: linear or spot.
BYBIT_CATEGORY=linear

# Kotak Neo API — keep these credentials private.
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=
KOTAK_ENVIRONMENT=prod

# Optional legacy DeepCharts API polling bot settings (for bot.py).
API_BASE_URL=https://YOUR-API-SERVICE.up.railway.app
APP_PIN=
API_TOKEN=
TELEGRAM_CHAT_ID=
BOT_SEND_TELEGRAM=true
POLL_SECONDS=15
