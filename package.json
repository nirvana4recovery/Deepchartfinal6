{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent || '')) { console.error('Use pnpm instead'); process.exit(1) }\"",
    "install-all": "pnpm install --frozen-lockfile",
    "dev": "pnpm --filter @workspace/trading-journal dev",
    "dev:api": "pnpm --filter @workspace/api-server dev",
    "dev:tablet": "pnpm --filter @workspace/trading-journal-tablet dev",
    "dev:all": "pnpm install --frozen-lockfile && pnpm -r --parallel --if-present run dev",
    "start": "pnpm --filter @workspace/trading-journal dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
